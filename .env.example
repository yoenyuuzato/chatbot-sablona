# Podle ai.provider v client.config.ts stačí JEDEN klíč:

# Gemini (free tier) – https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Claude – https://console.anthropic.com (placené podle spotřeby)
ANTHROPIC_API_KEY=
# Jen pokud Claude klíč není přiřazený k workspace: ID z console → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=

# --- Admin a databáze (/admin) ---
# Neon Postgres – Vercel → Storage → Neon (nebo neon.tech). Bez ní se profily čtou jen z client.config.ts.
DATABASE_URL=
# Heslo do /admin (dlouhé, náhodné)
ADMIN_PASSWORD=
# Volitelné: samostatný tajný klíč pro podpis přihlašovací cookie (jinak se použije ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Tajný klíč pro GET /api/profiles/<id>/knowledge (IG bot posílá Authorization: Bearer <klíč>)
KNOWLEDGE_API_SECRET=
